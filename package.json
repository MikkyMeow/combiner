{
  "name": "combiner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "build": "pnpm --filter api build && pnpm --filter web build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "tsx": "^4.17.2"
  }
}
